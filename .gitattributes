* text=auto
*.cs text eol=crlf
*.ps1 text eol=crlf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.png binary
*.jpg binary
*.db binary
*.db-wal binary
# Preserve the exact bytes referenced by immutable benchmark hash indexes.
/tests/benchmarks/evidence-v7-telegram/** -text
/tests/benchmarks/evidence-v8-telegram/** -text whitespace=cr-at-eol
/tests/benchmarks/evidence-v8-media-scale/** -text whitespace=cr-at-eol
/tests/benchmarks/evidence-v8-scale/** -text whitespace=cr-at-eol

/tests/benchmarks/evidence-v8-comparison/** -text whitespace=cr-at-eol

# Keep pinned dependency metadata byte-identical to the portable rebuild bundle.
/helpers/recovery_engine/requirements-lock.txt text eol=crlf
/helpers/recovery_engine/requirements-wheel-lock.txt text eol=crlf
/helpers/recovery_engine/storage-dependencies.json text eol=crlf
/helpers/recovery_engine/vendor-pins.json text eol=crlf
/tests/TelegramTlTests.py text eol=crlf
/tests/ApfsRecoveryTests.py text eol=crlf
/tests/BitLockerRecoveryTests.py text eol=crlf
/tests/TelegramDeletedTests.py text eol=crlf
/tests/TelegramResidualProvenanceTests.py text eol=crlf
/tests/DeletedArchiveSearchTests.py text eol=crlf
/tests/PngContextAuditTests.py text eol=crlf
# Preserve the trusted scorer bytes referenced by immutable comparison reports.
/tests/benchmarks/score_media_results.py text eol=crlf
