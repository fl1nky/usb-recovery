* text=auto
*.cs text eol=crlf
*.ps1 text eol=crlf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.png binary
*.jpg binary
*.db binary
*.db-wal binary
/tests/fixtures/telegram-cache-profiles/*.gz -text
/tests/fixtures/telegram-cache-profiles/LICENSE -text
/tests/fixtures/telegram-document-empty/*.gz -text
/tests/fixtures/telegram-document-empty/LICENSE -text
