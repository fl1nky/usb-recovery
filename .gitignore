# Source repository: recovered data, generated runtimes and build caches stay local
/*
!/README.md
!/build.ps1
!/src/
!/scripts/
!/.gitignore
!/.gitattributes
!/docs/
!/helpers/
!/tests/

# Keep only maintained helper sources and dependency inventories
/helpers/*
!/helpers/recovery_engine/
/helpers/recovery_engine/*
!/helpers/recovery_engine/*.py
!/helpers/recovery_engine/*.txt
!/helpers/recovery_engine/*.json

# Test source and small explicitly synthetic fixtures, never generated recoveries
/tests/*
!/tests/*.cs
!/tests/*.py
!/tests/*.ps1
!/tests/TelegramNativeFixtures/
!/tests/TelegramMediaFixtures/
!/tests/photorec-20261011T231546120952Z/
/tests/photorec-20261011T231546120952Z/*
!/tests/photorec-20261011T231546120952Z/fixtures/
/tests/photorec-20261011T231546120952Z/fixtures/*
!/tests/photorec-20261011T231546120952Z/fixtures/expected.png

**/__pycache__/
**/*.pyc
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.partial
**/.DS_Store
/build-signal-helpers.ps1
/docs/local/

# Portable builds and offline third-party sources are attached to GitHub Releases
/.build/
/tools/
/vendor/
/Готовая программа/

# Pinned public upstream storage parser test images, never user recovery data
!/tests/StorageFixtures/

# All generated output stays outside the source tree
/dist/
**/bin/
**/obj/

# Maintained independent benchmark sources only
!/tests/benchmarks/
/tests/benchmarks/*
!/tests/benchmarks/*.py
!/tests/benchmarks/*.ps1
!/tests/benchmarks/*.json
!/tests/benchmarks/*.md
!/tests/benchmarks/*.cs
!/tests/benchmarks/evidence/
/tests/benchmarks/evidence/*
!/tests/benchmarks/evidence/*.json
!/tests/benchmarks/evidence/*.md
